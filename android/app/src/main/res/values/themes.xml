<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WellnessApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#5eead4</item>
        <item name="colorPrimaryVariant">#2dd4bf</item>
        <item name="colorOnPrimary">#06241f</item>
        <item name="colorSecondary">#a78bfa</item>
        <item name="android:windowBackground">#0f1115</item>
        <item name="android:textColor">#e8eaf0</item>
        <item name="android:textColorHint">#6b7280</item>
        <item name="android:editTextColor">#ffffff</item>
        <item name="editTextStyle">@style/WellnessEditText</item>
    </style>

    <style name="WellnessEditText" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">#ffffff</item>
        <item name="android:textColorHint">#6b7280</item>
        <item name="android:backgroundTint">#5eead4</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="FieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textColor">#8b93a7</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="PermButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#e8eaf0</item>
        <item name="strokeColor">#2a2f3a</item>
    </style>
</resources>
