<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/tagline"
            android:textColor="#8b93a7" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#181b22"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textSize="12sp" />

        <TextView style="@style/SectionTitle" android:text="1. サーバー" />

        <EditText
            android:id="@+id/serverUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://xxxx.fly.dev"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="APP_TOKEN"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/reminderHour"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="夜の確認の時刻 (0-23)"
            android:inputType="number" />

        <Button
            android:id="@+id/saveBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="保存して自動同期を開始" />

        <TextView style="@style/SectionTitle" android:text="2. 権限 (一度だけ)" />

        <Button android:id="@+id/healthBtn" style="@style/PermButton" android:text="Health Connect を許可 (睡眠・心拍・HRV・歩数・運動)" />
        <Button android:id="@+id/usageBtn" style="@style/PermButton" android:text="使用状況へのアクセスを許可 (アプリ利用時間)" />
        <Button android:id="@+id/notifBtn" style="@style/PermButton" android:text="通知の読み取りを許可 (決済通知)" />
        <Button android:id="@+id/locationBtn" style="@style/PermButton" android:text="位置情報と通知を許可" />
        <Button android:id="@+id/backgroundLocationBtn" style="@style/PermButton" android:text="位置情報を「常に許可」にする" />

        <TextView style="@style/SectionTitle" android:text="3. 通知を拾うアプリ (パッケージ名, カンマ区切り)" />

        <EditText
            android:id="@+id/packages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="リストにないアプリでも「円」「ご利用」「お支払い」などを含む通知は拾います。"
            android:textColor="#8b93a7"
            android:textSize="12sp" />

        <TextView style="@style/SectionTitle" android:text="4. 動作確認" />

        <Button android:id="@+id/syncBtn" style="@style/PermButton" android:text="今すぐ同期" />
        <Button android:id="@+id/testBtn" style="@style/PermButton" android:text="サーバー接続テスト" />
        <Button android:id="@+id/openBtn" style="@style/PermButton" android:text="夜の確認画面を開く" />
        <Button android:id="@+id/reminderTestBtn" style="@style/PermButton" android:text="リマインド通知をテスト" />

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
