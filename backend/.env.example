# Shared secret used by the Android collector and the web UI
APP_TOKEN=change-me-to-a-long-random-string

# agent_sdk | api | rules
INFERENCE_BACKEND=agent_sdk
# Used when INFERENCE_BACKEND=api
ANTHROPIC_API_KEY=
# Used when INFERENCE_BACKEND=agent_sdk on a server: `claude setup-token` on your own machine
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL=claude-opus-5-5

# Google Calendar "secret address in iCal format", comma separated for several calendars
CALENDAR_ICS_URLS=

# Name the shop/facility behind a stay from OpenStreetMap (free, no key). Downloads named places
# for ~2 km tiles once and matches locally; individual coordinates never leave the server. none = off
POI_SOURCE=osm
POI_TILE_DEG=0.02

TIMEZONE=Asia/Tokyo
EVENING_PREPARE_HOUR=21
DATA_DIR=./data
# Optional: Postgres (Neon free tier etc). Leave empty to use SQLite in DATA_DIR.
DATABASE_URL=
DEMO_MODE=false
